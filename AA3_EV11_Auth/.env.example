# ============================================================
# Credenciales de Supabase — copia este archivo como .env
# y completa los valores desde: https://supabase.com/dashboard
# Proyecto → Settings → API
# ============================================================

# URL del proyecto (Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon / public) — SÍ se usa en el navegador
SUPABASE_ANON_KEY=pega_aqui_tu_anon_key

# Clave secreta (service_role) — NUNCA en HTML/JS del cliente
# Solo para backends (PHP, Node, etc.) con cuidado extremo
# SUPABASE_SERVICE_ROLE_KEY=no_pegar_esto_en_el_frontend

# ------------------------------------------------------------
# En este ejemplo estático (HTML/CSS/JS sin bundler),
# las variables de arriba se copian también a:
#   js/config.js
# (a partir de js/config.example.js)
# ------------------------------------------------------------
